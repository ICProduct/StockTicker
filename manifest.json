{
  "manifest_version": 3,
  "name": "上班偷偷看股票",
  "version": "1.2.0",
  "key": "",
  "description": "每 5 秒更新一次指定股票的即時報價。",
  "permissions": ["storage"],
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "64": "icon/64.png",
    "128": "icon/128.png"
  },
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://openapi.twse.com.tw/*",
    "https://www.tpex.org.tw/*"
  ],
  "action": {
    "default_title": "上班偷偷看股票",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png"
    }
  }
}
